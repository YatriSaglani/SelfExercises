import numpy as np

class Numpymath:

    def __init__(self):
        self.arr=np.array([])

    def create_array(self):
        values = input("Enter numbers separated by space: ")
        self.arr = np.array([float(x) for x in values.split()])
        print("Array created:", self.arr)

    def square(self):
        print("Square is ",np.square(self.arr))

    def square_root(self):
        print("Squareroot is ",np.sqrt(self.arr))

    def power(self):
        power=int(input("Enter the power : "))
        print("Power is ",np.pow(self.arr,power))

    def absolute_value(self):
        print("Absolute power is ",np.absolute(self.arr))

    def exponential(self):
        print("Exponential is ",np.exp(self.arr))

    def logarithm(self):
        print("Logarithm is ",np.log(self.arr))

    def sine(self, degree):
        radian = np.deg2rad(degree)
        print("Sin =", np.sin(radian))

    def cos(self, degree):
        radian = np.deg2rad(degree)
        print("Cos =", np.cos(radian))

    def tan(self, degree):
        radian = np.deg2rad(degree)
        print("Tan =", np.tan(radian))

    def ceil(self):
        print("Ceil value is ",np.ceil(self.arr))

    def floor(self):
        print("Floor value is ",np.floor(self.arr))

obj = Numpymath()

while True:
        print("*"*20,"Scientific math toolkit","*"*20)
        print("\n1.Enter number")
        print("2.Find square")
        print("3.Find squareroot")
        print("4.Find power")
        print("5.Find absolute value")
        print("6.Find exponential")
        print("7.Find Logarithm")
        print("8.Find Sine")
        print("9.Find cosine")
        print("10.Fine Tangent")
        print("11.Find ceil value")
        print("12.Find floor value")
        print("13.Exit\n")

        choice = int(input("Enter your choice : "))

        if choice==1:
          obj.create_array()

        elif choice==2:
          obj.square()

        elif choice==3:
          obj.square_root()

        elif choice==4:
          obj.power()

        elif choice==5:
          obj.absolute_value()

        elif choice==6:
          obj.exponential()

        elif choice==7:
          obj.logarithm()

        elif choice == 8:
            degree = int(input("Enter angle in degree: "))
            obj.sine(degree)

        elif choice == 9:
            degree = int(input("Enter angle in degree: "))
            obj.cos(degree)

        elif choice == 10:
            degree = int(input("Enter angle in degree: "))
            obj.tan(degree)
                    
        elif choice==11:
          obj.ceil()

        elif choice==12:
            obj.floor()

        elif choice==13:
            print("Thank you for using Scientific Math Toolkit! 🔬✨")
            print("Keep exploring, keep calculating! 🧮")
            print("Have a great day! 👋")
            break

        else:
            print("Invalid choice")
